# Server-only. The browser never sees this value.
# Local stack: http://localhost:8012
# Public edge:   https://argus-api.xurl.fyi
AGENT_URL=http://localhost:8012

# Optional. Must match PUBLIC_BFF_TOKEN on the public proxy.
# Leave blank for a local backend that does not require edge auth.
ARGUS_BFF_TOKEN=

# Optional. Leave blank when the public edge protects /jaeger with the BFF
# token. With a value, the trace panel links to the Jaeger UI.
NEXT_PUBLIC_JAEGER_URL=
